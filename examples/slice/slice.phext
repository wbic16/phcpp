// slice.cpp — phcpp vertical slice v0 (C++23 source of truth).
//
// Exercises exactly three C++ features, per the slice charter:
//   1. a class with a virtual function (polymorphic dispatch),
//   2. a function template, instantiated twice,
//   3. a destructor with an observable side effect.
// Output is fully deterministic and produced with std::printf so the
// hand-lowered C translation unit can match it byte-for-byte.
#phcpp-commentary	kind=gap	name=-	span=432-450	sha256=a3f2a419e8409f8b43d6084814d8c4f563b7e56ddc89a2c62d34675e27b0ff27
#include <cstdio>
#phcpp-commentary	kind=gap	name=-	span=450-451	sha256=01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b

#phcpp-commentary	kind=type	name=Shape	span=451-579	sha256=8d68ac4871fd3fc2e6c78685b14f33a4b68feeeb7bba22a805873c5eb37048c8
struct Shape {
    virtual ~Shape() = default;
    virtual double area() const = 0;
    virtual const char* name() const = 0;
};#phcpp-commentary	kind=gap	name=-	span=579-581	sha256=75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070


#phcpp-commentary	kind=type	name=Circle	span=581-801	sha256=a401ad62dd72d6c7a0c1c82a50e5e063d00a4eca6187661916cce464841e6fb9
struct Circle : Shape {
    double r;
    explicit Circle(double radius) : r(radius) {}
    double area() const override { return 3.141592653589793 * r * r; }
    const char* name() const override { return "circle"; }
};#phcpp-commentary	kind=gap	name=-	span=801-803	sha256=75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070


#phcpp-commentary	kind=type	name=Square	span=803-999	sha256=534da86ef1ebf545d1245dee64f881778abaf4755b60b83e987294e0ae6e08b9
struct Square : Shape {
    double s;
    explicit Square(double side) : s(side) {}
    double area() const override { return s * s; }
    const char* name() const override { return "square"; }
};#phcpp-commentary	kind=gap	name=-	span=999-1001	sha256=75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070


#phcpp-commentary	kind=function	name=add	span=1001-1056	sha256=8d843c305e7fc77c7c9bac9dd55ee520f077276cef9391299efba26655f15ad5
template <typename T>
T add(T a, T b) { return a + b; }#phcpp-commentary	kind=gap	name=-	span=1056-1058	sha256=75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070


#phcpp-commentary	kind=type	name=Tracer	span=1058-1265	sha256=e7400cdc502a86bea1eeba26bdf850fc21d9e03e7dab7c44ea8f43ad1b934fca
struct Tracer {
    const char* id;
    explicit Tracer(const char* name) : id(name) {
        std::printf("tracer %s constructed\n", id);
    }
    ~Tracer() { std::printf("tracer %s destroyed\n", id); }
};#phcpp-commentary	kind=gap	name=-	span=1265-1267	sha256=75a11da44c802486bc6f65640aa48a730f0f684c5c07a42ba3cd1735eb3fb070


#phcpp-commentary	kind=function	name=main	span=1267-1670	sha256=c00e455df60c7cd8fe74c4290d7d1b3ef37d0f618f42f03bd4ba17fab4e6d30d
int main() {
    Circle c(2.0);
    Square q(3.0);
    Shape* shapes[2] = { &c, &q };
    for (Shape* s : shapes)
        std::printf("%s area %.2f\n", s->name(), s->area());
    std::printf("add int %d\n", add(19, 23));
    std::printf("add double %.1f\n", add(1.25, 2.25));
    {
        Tracer t("inner");
        std::printf("inside scope\n");
    }
    std::printf("after scope\n");
    return 0;
}#phcpp-commentary	kind=gap	name=-	span=1670-1671	sha256=01ba4719c80b6fe911b091a7c05124b64eeece964e09c058ef8f9805daca546b

